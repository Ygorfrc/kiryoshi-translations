{
  "name": "kiryoshi-translations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:links": "node scripts/check-links.mjs",
    "test:seo": "node scripts/check-seo.mjs",
    "test:security": "node scripts/check-security.mjs",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "validate": "npm run lint && npm run check && npm test && npm run build && npm run test:links && npm run test:security && npm run test:seo && npm run test:e2e",
    "deploy:check": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.1",
    "@astrojs/rss": "4.0.19",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@lucide/astro": "1.61.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
