---
import { Heart, ArrowUpRight } from '@lucide/astro';
---

<section class="container support-section" aria-labelledby="support-title">
  <div class="support-icon">
    <Heart size={27} />
  </div>
  <div>
    <span class="eyebrow">CADA GESTO FAZ DIFERENÇA</span>
    <h2 id="support-title">
      Gratuito por princípio.
      <br />
      Possível com a comunidade.
    </h2>
    <p>Apoiar é uma escolha. Jogar em português será sempre para todos.</p>
  </div>
  <a class="button button-outline" href="/apoie/">
    Conheça formas de apoiar <ArrowUpRight size={17} />
  </a>
</section>
