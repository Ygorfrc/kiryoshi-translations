---
import { withBase } from '../lib/paths';
import Brand from './Brand.astro';
import { site } from '../config/site';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <Brand small />
      <p>
        Feito por um fã.
        <br />
        Para quem vive grandes histórias.
      </p>
      <span class="eyebrow">INDEPENDENTE · BRASILEIRO · GRATUITO</span>
    </div>
    <div>
      <h2>Explore</h2>
      <a href={withBase('/traducoes/')}>Traduções</a>
      <a href={withBase('/devlog/')}>Diário de desenvolvimento</a>
      <a href={withBase('/sobre/')}>Sobre o projeto</a>
      <a href={withBase('/apoie/')}>Apoie</a>
    </div>
    <div>
      <h2>Vamos conversar</h2>
      <a href={withBase('/contato/')}>Contato e comunidade</a>
      {site.channels.map((channel) => (
        <a href={channel.url} target="_blank" rel="noopener noreferrer">
          {channel.label} ↗
        </a>
      ))}
      {Astro.site && <a href={withBase('/rss.xml')}>Feed RSS</a>}
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {new Date().getUTCFullYear()} Kiryoshi Translations</span>
    <div>
      <a href={withBase('/privacidade/')}>Privacidade</a>
      <a href={withBase('/aviso-legal/')}>Aviso legal</a>
    </div>
  </div>
  <p class="container legal-note">
    Projeto independente de fãs, sem afiliação à Atlus, Sega ou Nintendo. Jogos
    e marcas pertencem aos respectivos titulares.
  </p>
</footer>
