---
import { withBase } from '../lib/paths';
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props {
  project: CollectionEntry<'translations'>;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const { cover, shortTitle, accent } = project.data;
const localImages = import.meta.glob<ImageMetadata>(
  '../../images/*.{avif,webp,png,jpg,jpeg}',
  { eager: true, import: 'default' },
);
const localImage =
  cover && 'asset' in cover
    ? localImages[`../../images/${cover.asset}`]
    : undefined;
if (cover && 'asset' in cover && !localImage)
  throw new Error(`Capa não encontrada em images/: ${cover.asset}`);
---

{cover && localImage ? (
  <Image
    class="game-cover-image"
    src={localImage}
    alt={cover.alt}
    widths={Array.from(
      new Set([160, 240, 360, 520, Math.min(localImage.width, 600)]),
    )
      .filter((width) => width <= localImage.width)
      .sort((a, b) => a - b)}
    sizes="(max-width: 580px) 46vw, (max-width: 799px) 35vw, 280px"
    width={Math.min(localImage.width, 600)}
    format="webp"
    quality={85}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
  />
) : cover && 'src' in cover ? (
  <img
    class="game-cover-image"
    src={withBase(cover.src)}
    alt={cover.alt}
    width={cover.width}
    height={cover.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
) : (
  <div
    class:list={['game-cover', `accent-${accent}`]}
    role="img"
    aria-label={`Capa ilustrativa de ${shortTitle}; arte oficial não fornecida`}
  >
    <div class="cover-platform">
      NINTENDO <b>3DS</b>
    </div>
    <span class="cover-series">SHIN MEGAMI TENSEI</span>
    <svg
      class="cover-symbol"
      viewBox="0 0 200 220"
      fill="none"
      aria-hidden="true"
    >
      <path d="m100 5 85 52v106l-85 52-85-52V57L100 5Z" stroke="currentColor" />
      <path d="m100 30 63 39v80l-63 39-63-39V69l63-39Z" stroke="currentColor" />
      <circle cx="100" cy="110" r="49" stroke="currentColor" stroke-width="2" />
      <path
        d="M100 40v140M30 110h140M60 65l80 90M140 65l-80 90"
        stroke="currentColor"
      />
      <circle cx="100" cy="110" r="13" fill="currentColor" />
    </svg>
    <strong>{shortTitle}</strong>
    <span class="cover-caption">ARTE ILUSTRATIVA · PLACEHOLDER</span>
  </div>
)}
