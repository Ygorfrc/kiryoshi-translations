---
interface Props {
  small?: boolean;
}
const { small = false } = Astro.props;
---

<a
  class:list={['brand', { small }]}
  href="/"
  aria-label="Kiryoshi Translations — início"
>
  <svg
    width="38"
    height="42"
    viewBox="0 0 38 42"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M3 10 19 1l16 9v22l-16 9L3 32V10Z"
      stroke="currentColor"
      stroke-width="2"
    />
    <path
      d="M12 11v20m1-10 12-10m-12 9 13 11"
      stroke="currentColor"
      stroke-width="3"
    />
  </svg>
  <span>
    KIRYOSHI <small>TRANSLATIONS</small>
  </span>
</a>
