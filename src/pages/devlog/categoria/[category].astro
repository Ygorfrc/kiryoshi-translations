---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageIntro from '../../../components/PageIntro.astro';
import DevlogListing from '../../../components/DevlogListing.astro';
import { categories } from '../../../lib/schemas';
import { categorySlug } from '../../../lib/categories';
import { getPosts } from '../../../lib/content';
export function getStaticPaths() {
  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: { category },
  }));
}
interface Props {
  category: string;
}
const { category } = Astro.props;
const posts = (await getPosts()).filter((p) => p.data.category === category);
---

<BaseLayout
  title={`${category} — Devlog`}
  description={`Publicações de ${category.toLocaleLowerCase('pt-BR')} no diário de desenvolvimento de Kiryoshi Translations.`}
>
  <PageIntro
    title={category}
    eyebrow="CATEGORIAS DO DEVLOG"
    description={`Registros sobre ${category.toLocaleLowerCase('pt-BR')}, reunidos em um só lugar.`}
    breadcrumb={`Devlog · ${category}`}
  />
  <DevlogListing posts={posts} category={category} />
</BaseLayout>
