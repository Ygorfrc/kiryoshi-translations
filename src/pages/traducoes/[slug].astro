---
import { withBase } from '../../lib/paths';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Download, ArrowUpRight, Info } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameCover from '../../components/GameCover.astro';
import PlatformText from '../../components/PlatformText.astro';
import ProjectStatus from '../../components/ProjectStatus.astro';
import ProgressIndicator from '../../components/ProgressIndicator.astro';
import DevlogCard from '../../components/DevlogCard.astro';
import { formatDate, formatBytes } from '../../lib/format';
import { getPosts } from '../../lib/content';
export async function getStaticPaths() {
  return (await getCollection('translations')).map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}
interface Props {
  project: CollectionEntry<'translations'>;
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const related = (await getPosts())
  .filter((p) => p.data.translation === project.id)
  .slice(0, 3);
const releases = [...data.releases].sort(
  (a, b) => b.date.getTime() - a.date.getTime(),
);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: data.title,
  description: data.description,
  inLanguage: 'pt-BR',
  about: {
    '@type': 'VideoGame',
    name: data.title,
    gamePlatform: data.platform,
    genre: data.genre,
  },
};
---

<BaseLayout
  title={`${data.shortTitle} — tradução PT-BR`}
  description={data.description}
  jsonLd={jsonLd}
  noindex={data.example}
>
  <div class="container project-top">
    <Breadcrumbs
      items={[
        { label: 'Traduções', href: '/traducoes/' },
        { label: data.shortTitle },
      ]}
    />
    {data.example && (
      <div class="notice">
        <Info size={15} class="inline-block mr-2" />
        Cadastro inicial configurável. Informações não confirmadas permanecem
        como “Não informado”. Títulos planejados não são anúncios de
        desenvolvimento.
      </div>
    )}
    <header class="project-head">
      <GameCover project={project} eager />
      <div>
        <span class="eyebrow cyan">TRADUÇÃO INDEPENDENTE · PT-BR</span>
        <h1>{data.title}</h1>
        <ProjectStatus status={data.status} />
        <p class="lead mt-5">{data.description}</p>
        <dl class="project-facts">
          <div>
            <dt>Plataforma</dt>
            <dd>
              <PlatformText text={data.platform} />
            </dd>
          </div>
          <div>
            <dt>Desenvolvedora</dt>
            <dd>{data.developer ?? 'Não informado'}</dd>
          </div>
          <div>
            <dt>Publicadora</dt>
            <dd>{data.publisher ?? 'Não informado'}</dd>
          </div>
          <div>
            <dt>Gênero</dt>
            <dd>{data.genre ?? 'Não informado'}</dd>
          </div>
          <div>
            <dt>Última atualização</dt>
            <dd>
              {data.updated ? (
                <time datetime={data.updated.toISOString()}>
                  {formatDate(data.updated)}
                </time>
              ) : (
                'Não informado'
              )}
            </dd>
          </div>
          <div>
            <dt>Idioma da tradução</dt>
            <dd>Português brasileiro</dd>
          </div>
          <div>
            <dt>Processo de tradução</dt>
            <dd>Auxílio de IA e revisão humana</dd>
          </div>
        </dl>
        <a class="button button-outline button-small" href="#downloads">
          {releases.length ? 'Ver downloads' : 'Situação do patch'}{' '}
          <Download size={16} />
        </a>
      </div>
    </header>
    <nav class="project-anchor-nav" aria-label="Nesta tradução">
      <a href="#sobre-traducao">Sobre</a>
      <a href="#progresso">Progresso</a>
      <a href="#downloads">Downloads</a>
      <a href="#instalacao">Instalação</a>
      <a href="#perguntas">Perguntas frequentes</a>
    </nav>
    <div class="project-body">
      <div class="project-content">
        <div id="sobre-traducao" class="prose">
          <Content />
        </div>
        <section id="midia">
          <h2>
            Dentro do jogo<span class="purple">.</span>
          </h2>
          {data.screenshots.length ? (
            <div class="screenshots">
              {data.screenshots.map((shot) => (
                <figure>
                  <img
                    src={withBase(shot.src)}
                    alt={shot.alt}
                    width={shot.width}
                    height={shot.height}
                    loading="lazy"
                  />
                  <figcaption>{shot.credit}</figcaption>
                </figure>
              ))}
            </div>
          ) : (
            <p>
              Screenshots reais da tradução ainda não foram fornecidas. Serão
              adicionadas quando houver material autorizado.
            </p>
          )}
          {data.video ? (
            <a
              class="button button-outline"
              href={`https://www.youtube.com/watch?v=${data.video.id}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              {data.video.title} <ArrowUpRight size={16} />
            </a>
          ) : (
            <p class="fine-print">Vídeo de demonstração: não informado.</p>
          )}
        </section>
        <section id="downloads">
          <h2>
            Downloads e versões<span class="purple">.</span>
          </h2>
          {releases.length ? (
            releases.map((release) => (
              <article class="release-card">
                <h3>Patch {release.version}</h3>
                <p class="fine-print">
                  <time datetime={release.date.toISOString()}>
                    {formatDate(release.date)}
                  </time>{' '}
                  · {release.format} · {formatBytes(release.sizeBytes)}
                </p>
                <ul class="list-disc pl-5">
                  {release.changelog.map((change) => (
                    <li>{change}</li>
                  ))}
                </ul>
                {release.sha256 && (
                  <p>
                    <span class="eyebrow">SHA-256</span>
                    <code class="hash">{release.sha256}</code>
                  </p>
                )}
                <div class="button-row">
                  <a
                    class="button button-primary"
                    href={release.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Baixar patch {release.version} <Download size={16} />
                  </a>
                  <a
                    class="button button-outline"
                    href={withBase(release.tutorial)}
                  >
                    Tutorial de instalação
                  </a>
                </div>
              </article>
            ))
          ) : (
            <div class="notice">
              <strong>Nenhum patch disponível.</strong>
              <p class="mt-2">
                {data.status === 'Planejado'
                  ? 'Este título está na lista de interesse futuro. Não há versão ou data de lançamento informada.'
                  : 'O projeto ainda não tem um patch autorizado cadastrado para download. Acompanhe esta página e o devlog para novidades confirmadas.'}
              </p>
            </div>
          )}
        </section>
        <section id="instalacao">
          <h2>
            Antes de instalar<span class="purple">.</span>
          </h2>
          <ul class="requirements list-disc pl-5">
            {(data.requirements.length
              ? data.requirements
              : [
                  'Você precisará de uma cópia legítima e compatível do jogo.',
                  'Região, versão, ferramentas e instruções específicas ainda não foram informadas.',
                ]
            ).map((item) => (
              <li>
                <PlatformText text={item} />
              </li>
            ))}
          </ul>
          <p>
            O site distribui somente patches autorizados. Não hospedamos ROMs,
            ISOs, CIAs ou cópias integrais dos jogos.
          </p>
          <a class="text-link" href={withBase('/aviso-legal/')}>
            Leia o aviso legal <ArrowUpRight size={16} />
          </a>
        </section>
        <section id="creditos">
          <h2>
            Créditos<span class="purple">.</span>
          </h2>
          {data.credits.length ? (
            <ul class="credits list-disc">
              {data.credits.map((credit) => (
                <li>
                  <strong>{credit.name}</strong> — {credit.role}
                </li>
              ))}
            </ul>
          ) : (
            <p>Colaboradores ainda não informados.</p>
          )}
          <p class="fine-print">
            Créditos se referem ao trabalho de tradução independente. O jogo e
            seus assets pertencem aos respectivos titulares.
          </p>
          {data.cover && <p class="fine-print">Capa: {data.cover.credit}</p>}
        </section>
        <section id="perguntas" class="faq">
          <h2>
            Perguntas frequentes<span class="purple">.</span>
          </h2>
          {(data.faq.length
            ? data.faq
            : [
                {
                  question: 'O projeto já começou?',
                  answer:
                    'Este cadastro indica interesse futuro. O início de desenvolvimento e sua viabilidade ainda não foram confirmados.',
                },
                {
                  question: 'A tradução será gratuita?',
                  answer: 'Sim. Nenhum patch será condicionado a pagamentos.',
                },
              ]
          ).map((item) => (
            <details>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
          <details>
            <summary>As traduções usam inteligência artificial?</summary>
            <p>
              Sim. O processo do Kiryoshi Translations combina auxílio de
              inteligência artificial (IA) e revisão humana dos textos.
              <a href={withBase('/sobre/#traducao-ia')}>
                Saiba mais sobre o processo.
              </a>
            </p>
          </details>
        </section>
      </div>
      <aside class="project-sidebar" aria-label="Acompanhamento">
        <section id="progresso">
          <span class="eyebrow cyan">PASSO A PASSO</span>
          <h2 class="mt-3">Andamento do projeto</h2>
          <ProgressIndicator progress={data.progress} />
        </section>
        <section>
          <span class="eyebrow">SEM PRESSA. COM CUIDADO.</span>
          <h2 class="mt-3">Histórias levam tempo.</h2>
          <p class="fine-print">
            {releases.length
              ? 'Consulte as versões e suas instruções antes de instalar. As traduções são gratuitas.'
              : 'O trabalho é independente e feito por um fã. Não há previsão de lançamento informada.'}
          </p>
          <a class="text-link" href={withBase('/devlog/')}>
            Acompanhar o devlog <ArrowUpRight size={15} />
          </a>
        </section>
      </aside>
    </div>
  </div>
  {related.length > 0 && (
    <section class="container section">
      <div class="section-heading">
        <h2>
          Notas deste projeto<span class="purple">.</span>
        </h2>
      </div>
      <div class="devlog-grid">
        {related.map((post, index) => (
          <DevlogCard post={post} index={index} />
        ))}
      </div>
    </section>
  )}
</BaseLayout>
