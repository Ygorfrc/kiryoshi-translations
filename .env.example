# Domínio público real, sem barra final. Vazio = prévia não indexável.
PUBLIC_SITE_URL=https://kiryoshitranslations.com.br
# / no domínio próprio e Cloudflare; /kiryoshi-translations/ apenas no endereço github.io.
PUBLIC_BASE_PATH=/
# true para prévias; false libera apenas páginas editorialmente aprovadas.
PUBLIC_NOINDEX=false
# cloudflare ou github-pages (altera a informação de hospedagem na privacidade).
PUBLIC_HOSTING=github-pages
# Opcional: endereço HTTPS da sua conta GoatCounter (público, não é uma API key).
# Vazio desativa; ausente usa site.downloadCounterUrl. Mudanças exigem a origem exata em connect-src.
PUBLIC_DOWNLOAD_COUNTER_URL=https://kiryoshi.goatcounter.com
