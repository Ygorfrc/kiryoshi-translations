# Domínio público real, sem barra final. Vazio = prévia não indexável.
PUBLIC_SITE_URL=
# / para Cloudflare; /kiryoshi-translations/ para GitHub Pages.
PUBLIC_BASE_PATH=/
# Prévia pública temporária: mantém noindex mesmo com URL real.
PUBLIC_NOINDEX=false
# cloudflare ou github-pages (altera a informação de hospedagem na privacidade).
PUBLIC_HOSTING=cloudflare
